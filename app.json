{
  "expo": {
    "name": "YOUchi",
    "slug": "youchi",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "youchi",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF9F6",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.youchi.habits",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSHealthShareUsageDescription": "YOUchi reads your steps and workouts to complete your daily movement goal automatically.",
        "NSHealthUpdateUsageDescription": "YOUchi does not write health data."
      }
    },
    "android": {
      "package": "com.youchi.habits",
      "adaptiveIcon": {
        "backgroundColor": "#8EA58D",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.health.READ_EXERCISE"
      ]
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FAF9F6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "YOUchi saves your pet card to your photos when you ask it to.",
          "photosPermission": "YOUchi only adds pet cards you choose to save.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "YOUchi uses the camera for your daily progress selfie. Photos stay on this device.",
          "photosPermission": "YOUchi lets you pick a progress selfie from your photos. Photos stay on this device."
        }
      ],
      [
        "react-native-health",
        {
          "healthSharePermission": "YOUchi reads your steps and workouts to complete your daily movement goal automatically.",
          "healthUpdatePermission": "YOUchi does not write health data."
        }
      ],
      "react-native-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.youchi.habits",
          "widgets": [
            {
              "name": "YouchiWidget",
              "displayName": "YOUchi",
              "description": "Your pet and today's goals at a glance.",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            }
          ],
          "bundleIdentifier": "com.youchi.habits.widgets"
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "YouchiWidget",
              "label": "YOUchi",
              "description": "Your pet and today's goals at a glance.",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#8EA58D",
          "defaultChannel": "daily-reminder"
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "ExpoWidgetsTarget",
                  "bundleIdentifier": "com.youchi.habits.widgets",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.youchi.habits"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "6bb0a6e5-34e6-4198-b265-1a266b2cf435"
      }
    },
    "owner": "personal613"
  }
}
