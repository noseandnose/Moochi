{
  "name": "mochi",
  "main": "index.js",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "npm run web:setup && expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "art": "python3 tools/art/build.py",
    "doctor": "expo-doctor",
    "web:setup": "node -e \"require('fs').mkdirSync('public',{recursive:true});require('fs').copyFileSync(require.resolve('canvaskit-wasm/bin/full/canvaskit.wasm'),'public/canvaskit.wasm')\""
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.6.2",
    "expo": "~57.0.28",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-media-library": "~57.0.5",
    "expo-router": "~57.0.26",
    "expo-sharing": "~57.0.23",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-widgets": "~57.0.24",
    "lucide-react-native": "^1.55.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-android-widget": "^0.22.1",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-health": "^1.19.0",
    "react-native-health-connect": "^4.1.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "canvaskit-wasm": "^0.41.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "typescript": "~6.0.3"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-health"
        ],
        "listUnknownPackages": false
      }
    }
  },
  "overrides": {
    "react-native-health": {
      "@expo/config-plugins": "57.0.10"
    }
  }
}
